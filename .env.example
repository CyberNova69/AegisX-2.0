# AegisX Environment Secrets Template
# ====================================
# Copy this file to .env and insert your real credentials.
# NEVER commit .env or real credentials to Git!

# External LLM API Credentials (Required if using provider.name = 'api')
LLM_API_KEY=your_api_key_here

# Optional: Custom API Base URL (Default: https://api.openai.com/v1)
LLM_API_BASE=https://api.openai.com/v1

# Optional: Custom Default Provider Override ('mock', 'api', 'local')
LLM_PROVIDER=mock

# Optional: Custom Default Model Override
LLM_MODEL=mock-soc-analyst-v1
